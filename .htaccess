# Always use HTTPS and the www-less address
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Send /index.html to the clean address /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# Old trading blog (archived): those articles and the translated sections return 410 Gone
RewriteRule ^(ml|ta|hi)(/.*)?$ - [G,L]
RewriteRule ^blog/(best-time-to-trade-xauusd-in-india-ist|candlestick-patterns-for-xauusd-trading|what-is-xauusd-gold-trading-guide|what-moves-gold-prices-xauusd-drivers|xauusd-lot-size-pip-value-position-sizing|xauusd-risk-management-rules|how-to-choose-a-forex-broker-for-gold-trading|how-to-open-a-forex-trading-account-step-by-step|what-is-a-forex-rebate-ib-cashback|xrover-5-intelligent-candle-trading-system-explained)(/.*)?$ - [G,L]
RewriteRule ^blog/feed\.xml$ - [G,L]

# Rebate portal stays usable but out of search results
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/rebate#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Compress text files for faster loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Cache images for a week
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
</IfModule>
